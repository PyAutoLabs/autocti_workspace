output/
*.sqlite
__pycache__/
*.pyc
/*.png

# Datasets are simulated at runtime by the workspace simulator scripts, which the
# example scripts invoke automatically when the dataset is missing. Everything
# under `dataset/` is therefore ignored by default; the `!` lines below are the
# allowlist of datasets that remain committed by design.
dataset/**
!dataset/.gitignore
!dataset/dataset_1d/**
!dataset/overview/**

# Generated plots and corrected-data products produced by the tutorial simulators
# / correction scripts — never committed, even inside an allowlisted directory.
dataset/**/*.png
dataset/**/ccd_plot/
dataset/**/fpa_plot/
dataset/imaging_ci/diagnostic_plot/
dataset/imaging_ci/poisson/
dataset/**/correction/
dataset/**/clocker_correction.json
dataset/**/cti_correction.json
dataset/**/interpolator.json
dataset/**/data_corrected.fits
dataset/overview/imaging_ci/uniform/
